# =============================================================================
# 敏感配置模板 — 复制本文件为 .env 后填写真实值
#   cp config/.env.example config/.env   (Linux/macOS)
#   copy config\.env.example config\.env (Windows)
#
# .env 已加入 .gitignore，请勿提交到 Git / 聊天 / 截图
# =============================================================================

# --- Tushare ---
TUSHARE_TOKEN=your_tushare_token_here

# --- 聚宽 JoinQuant ---
JQDATA_USER=your_phone_or_username
JQDATA_PASSWORD=your_password_here

# --- 数据库（若后续接入）---
# DATABASE_URL=postgresql://user:password@localhost:5432/quant

# --- 其他 API（按需添加）---
# AKSHARE_PROXY=
# WIND_USER=
# WIND_PASSWORD=
